<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="1244px"
    android:layout_height="1252px"
    android:id="@+id/myFrameLayout"
    android:padding="1dp">
    <!-- 背景ImageView -->

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"

        android:id="@+id/aiagentlinearLayout"

        android:orientation="vertical">
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"

            android:id="@+id/tipslayout"
            android:layout_marginLeft="422px"
            android:orientation="horizontal">
            <ImageView
                android:id="@+id/roboticon"
                android:layout_width="147px"
                android:layout_height="147px"

                android:scaleType="fitXY"
                android:src="@drawable/robot"
                android:visibility="visible" />
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="187px"
                android:layout_marginTop="15px"
                android:id="@+id/inputtextslayout"

                android:orientation="vertical">
                <TextView
                    android:id="@+id/inputtext"
                    android:layout_width="323px"
                    android:layout_height="63px"
                    android:textColor="#FF000000"
                    android:textSize="20sp"/>
                <TextView
                    android:id="@+id/proceduer"
                    android:layout_width="235px"
                    android:layout_height="40px"
                    android:textColor="#FF007AFF"
                    android:text="qwen3.0生成中..."
                    android:visibility="gone"
                    android:textSize="15sp"/>
            </LinearLayout>
        </LinearLayout>
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"

            android:id="@+id/btnslayout"
            android:visibility="gone"
            android:orientation="vertical">
            <LinearLayout
                android:layout_width="1000px"
                android:layout_height="240px"
                android:layout_marginLeft="120px"
                android:layout_marginTop="96px"
                android:id="@+id/radiolayout"

                android:orientation="horizontal">
                <android.widget.Switch
                    android:id="@+id/btnwindow"
                    android:layout_width="281px"
                    android:layout_height="177px"
                    android:layout_marginTop="31px"

                    android:scaleType="fitXY"
                    android:background="@drawable/radiobtnbg"
                    android:textSize="10sp"

                    android:text="车窗"/>
                <android.widget.Switch
                    android:id="@+id/btnoutdoor"
                    android:layout_width="281px"
                    android:layout_height="177px"
                    android:layout_marginTop="31px"
                    android:layout_marginLeft="50px"

                    android:scaleType="fitXY"
                    android:background="@drawable/radiobtnbg"
                    android:textSize="10sp"

                    android:text="外循环"/>
                <android.widget.Switch
                    android:id="@+id/btncleanair"
                    android:layout_width="281px"
                    android:layout_height="177px"
                    android:layout_marginTop="31px"
                    android:layout_marginLeft="50px"

                    android:scaleType="fitXY"
                    android:background="@drawable/radiobtnbg"
                    android:textSize="10sp"
                    android:text="净化空气"/>


            </LinearLayout>
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"

                android:id="@+id/nmbtnslayout"

                android:orientation="horizontal">
                <android.widget.Button
                    android:id="@+id/btncancel"
                    android:layout_width="156px"
                    android:layout_height="80px"
                    android:layout_marginTop="174px"
                    android:layout_marginLeft="350px"

                    android:scaleType="fitXY"
                    android:background="@drawable/button_selector"
                    android:text="取消"/>
                <android.widget.Button
                    android:id="@+id/btnexecute"
                    android:layout_width="156px"
                    android:layout_height="80px"
                    android:layout_marginTop="174px"
                    android:layout_marginLeft="168px"

                    android:scaleType="fitXY"
                    android:background="@drawable/button_selector"
                    android:text="执行"/>

            </LinearLayout>
        </LinearLayout>
        <WebView
            android:id="@+id/responseWebView"
            android:layout_width="1200px"
            android:layout_height="1028px"
            android:layout_marginLeft="20px"
            android:layout_marginTop="20px"
            android:elevation="2dp" />
    </LinearLayout>

</FrameLayout>