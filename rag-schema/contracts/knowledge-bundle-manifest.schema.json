{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hirain.com/aiagent/rag/contracts/knowledge-bundle-manifest-v1.schema.json",
  "title": "Vehicle Knowledge Bundle Manifest V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["formatVersion", "bundleId", "bundleVersion", "knowledgeScopeId", "builderVersion", "builtAtEpochMs", "objectBoxVersion", "schemaFingerprint", "sourceLocatorSchemaVersion", "dataFile", "embedding", "hnsw", "scope", "parsers", "lexical", "chunking", "corpus"],
  "properties": {
    "formatVersion": {"const": 1},
    "bundleId": {"type": "string", "minLength": 1},
    "bundleVersion": {"type": "string", "minLength": 1},
    "knowledgeScopeId": {"type": "string", "minLength": 1},
    "builderVersion": {"type": "string", "minLength": 1},
    "builtAtEpochMs": {"type": "integer", "minimum": 0},
    "objectBoxVersion": {"type": "string", "minLength": 1},
    "schemaFingerprint": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "sourceLocatorSchemaVersion": {"const": 1},
    "dataFile": {"type": "object", "additionalProperties": false, "required": ["name", "sizeBytes", "sha256"], "properties": {"name": {"const": "data.mdb"}, "sizeBytes": {"type": "integer", "minimum": 1}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}},
    "embedding": {"type": "object", "additionalProperties": false, "required": ["provider", "model", "dimension", "distanceType", "templateVersion"], "properties": {"provider": {"const": "DashScope"}, "model": {"const": "text-embedding-v4"}, "dimension": {"const": 1024}, "distanceType": {"const": "COSINE"}, "templateVersion": {"const": 1}}},
    "hnsw": {"type": "object", "additionalProperties": false, "required": ["configFingerprint", "neighborsPerNode", "indexingSearchCount", "reparationBacklinkProbability", "vectorCacheHintSizeKB", "flags"], "properties": {"configFingerprint": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}, "neighborsPerNode": {"type": "integer", "minimum": 1}, "indexingSearchCount": {"type": "integer", "minimum": 1}, "reparationBacklinkProbability": {"type": "number", "minimum": 0.0, "maximum": 1.0}, "vectorCacheHintSizeKB": {"type": "integer", "minimum": 0}, "flags": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}}},
    "scope": {"type": "object", "additionalProperties": false, "required": ["vehicleModel", "modelYear", "region", "softwareVersion", "configurationCode"], "properties": {"vehicleModel": {"type": "string", "minLength": 1}, "modelYear": {"type": "string", "minLength": 1}, "region": {"type": "string", "minLength": 1}, "softwareVersion": {"type": "string", "minLength": 1}, "configurationCode": {"type": "string", "minLength": 1}}},
    "parsers": {"type": "object", "additionalProperties": false, "required": ["configHash", "supportedSourceFormats", "pdf", "html", "markdown"], "properties": {"configHash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}, "supportedSourceFormats": {"const": ["PDF", "STATIC_HTML", "MARKDOWN"]}, "pdf": {"type": "object"}, "html": {"type": "object", "additionalProperties": false, "required": ["contentRootSelector", "excludeSelectors", "mode", "networkAccess", "scriptExecution"], "properties": {"contentRootSelector": {"type": "string"}, "excludeSelectors": {"type": "array", "items": {"type": "string"}}, "mode": {"const": "STATIC_DOM_ONLY"}, "networkAccess": {"const": false}, "scriptExecution": {"const": false}, "embeddedDataExtraction": {"enum": ["NONE", "TESLA_SERVICE_CENTERS_V1"]}}}, "markdown": {"type": "object"}}},
    "lexical": {"type": "object", "additionalProperties": false, "required": ["analyzerVersion", "languages", "algorithm", "tokenization"], "properties": {"analyzerVersion": {"const": 1}, "languages": {"type": "array", "minItems": 1}, "algorithm": {"const": "BM25"}, "tokenization": {"const": "CJK_BIGRAM_TRIGRAM_WITH_EXACT_LATIN"}}},
    "chunking": {"type": "object", "additionalProperties": false, "required": ["configVersion", "configHash"], "properties": {"configVersion": {"const": 1}, "configHash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}}},
    "corpus": {"type": "object", "additionalProperties": false, "required": ["corpusHash", "documentCount", "sourceFormatCounts", "parentChunkCount", "childChunkCount", "lexicalTermCount"], "properties": {"corpusHash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}, "documentCount": {"type": "integer", "minimum": 0}, "sourceFormatCounts": {"type": "object"}, "parentChunkCount": {"type": "integer", "minimum": 0}, "childChunkCount": {"type": "integer", "minimum": 0}, "lexicalTermCount": {"type": "integer", "minimum": 0}}}
  }
}
